# ElectroCraft ConnectorGateway
# Public gateway endpoint only. Never place API keys, tokens, passwords or secret values in this file.
VITE_ELECTROCRAFT_CONNECTOR_GATEWAY_URL=

# Server-side secret values follow this generated convention and belong only in the server/secret manager:
# ELECTROCRAFT_SECRET_<SECRET_KEY>_DEVELOPMENT=
# ELECTROCRAFT_SECRET_<SECRET_KEY>_PRODUCTION=
