{
  "name": "@electrocraft/data-source-poc",
  "private": true,
  "version": "0.0.0-m00.9",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "test:offline": "node --test test/*.test.mjs",
    "test:parser": "node scripts/parser-probe.mjs",
    "test": "npm run test:offline && npm run test:parser",
    "secret-scan": "node scripts/secret-scan.mjs",
    "metrics": "node scripts/bundle-metrics.mjs",
    "build": "node scripts/build.mjs",
