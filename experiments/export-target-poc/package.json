    "verify:php": "node scripts/verify-php.mjs",
    "verify:static": "node scripts/verify-static.mjs",
    "build": "node scripts/build.mjs",
    "check:static": "npm run generate && npm run lint && npm run typecheck && npm run test && npm run verify:php && npm run verify:static && npm run build",
    "verify:capacitor-real": "node scripts/verify-capacitor-real.mjs",
    "verify:lamp-real": "node scripts/verify-lamp-real.mjs",
